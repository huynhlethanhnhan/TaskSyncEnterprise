# ==============================================================================
# TaskSyncEnterprise Production Environment Configuration Template
# ==============================================================================
# Copy this file to '.env.production' in your production environment before deploying.
# WARNING: Never commit actual secret keys or passwords to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION PROFILE (Required / Safe Default)
# ------------------------------------------------------------------------------
# Enforces production security checks (strong keys, JSON logging, restricted APIs).
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 2. SECURITY SECRETS (Required - Must be set to strong unique values)
# ------------------------------------------------------------------------------
# SECRET_KEY: Cryptographically random key (at least 32 characters) used to sign JWTs.
# Generate on Linux using: openssl rand -hex 32
# DO NOT use default development keys or placeholders.
SECRET_KEY=

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (Required - Must be set to strong values)
# ------------------------------------------------------------------------------
# MSSQL_SA_PASSWORD: SA password for the SQL Server container.
# Must meet MS SQL Server complexity policies (digits, casing, specials).
MSSQL_SA_PASSWORD=

# ------------------------------------------------------------------------------
# 4. NETWORK GOVERNANCE (Required - CORS & Host Headers verification)
# ------------------------------------------------------------------------------
# BACKEND_CORS_ORIGINS: List of allowed origins for browser-based client API requests.
# Format: JSON array of URLs. Wildcard '*' is strictly prohibited in production.
BACKEND_CORS_ORIGINS=["http://127.0.0.1:8080"]

# ALLOWED_HOSTS: List of allowed Host header names to prevent HTTP Host Header attacks.
# Format: JSON array of strings. Wildcard '*' is strictly prohibited in production.
ALLOWED_HOSTS=["127.0.0.1", "localhost", "backend"]

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION (Optional / Safe Default)
# ------------------------------------------------------------------------------
# VITE_API_URL: Target endpoint for the React client API requests.
# Defaults to '/api/v1' for relative routing behind reverse proxy (Phase 3.8.6).
VITE_API_URL=/api/v1

# ------------------------------------------------------------------------------
# 6. LOGGING & OBSERVABILITY (Optional / Safe Defaults)
# ------------------------------------------------------------------------------
# LOG_LEVEL: Severity filter for application logs.
LOG_LEVEL=INFO

# ENABLE_FILE_LOGGING: Writes rotating JSON logs to /app/logs.
ENABLE_FILE_LOGGING=true

# ENABLE_CONSOLE_LOGGING: Emits structured JSON logs to standard output.
ENABLE_CONSOLE_LOGGING=true

# PROMETHEUS_RETENTION_TIME: How long Prometheus keeps time-series data.
PROMETHEUS_RETENTION_TIME=15d

# PROMETHEUS_RETENTION_SIZE: Maximum storage capacity allocated to TSDB.
PROMETHEUS_RETENTION_SIZE=10GB

# GRAFANA_ADMIN_USER: Default administrator username for Grafana.
GRAFANA_ADMIN_USER=admin

# GRAFANA_ADMIN_PASSWORD: Password for Grafana administrative portal.
# Must be set to a secure unique password.
GRAFANA_ADMIN_PASSWORD=
