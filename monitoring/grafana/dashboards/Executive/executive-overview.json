{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Executive Landing Dashboard summarizing overall system availability, application health, infrastructure resources, database/cache status, and performance metrics.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": true,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "tags": ["tasksync"],
      "targetBlank": false,
      "title": "TaskSync Navigation Menu",
      "type": "dashboards"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "1. Executive Summary",
      "type": "row"
    },
    {
      "title": "System Availability",
      "type": "stat",
      "gridPos": {"h": 4, "w": 5, "x": 0, "y": 1},
      "id": 1,
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "avg(up{environment=~\"$environment\"}) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 95},
              {"color": "green", "value": 99}
            ]
          }
        }
      },
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "value"},
      "links": [
        {
          "targetBlank": false,
          "title": "Open Diagnostics Overview",
          "url": "/d/tasksync-development-diagnostics?var-datasource=${datasource}&var-environment=${environment}"
        }
      ]
    },
    {
      "title": "Application Health",
      "type": "stat",
      "gridPos": {"h": 4, "w": 5, "x": 5, "y": 1},
      "id": 2,
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "sum(up{job=\"tasksync-backend\", environment=~\"$environment\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"1": {"text": "UP", "color": "green"}, "0": {"text": "DOWN", "color": "red"}}}
          ]
        }
      },
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "value"},
      "links": [
        {
          "targetBlank": false,
          "title": "Open Backend Overview",
          "url": "/d/tasksync-backend-overview?var-datasource=${datasource}&var-environment=${environment}"
        }
      ]
    },
    {
      "title": "Container Status",
      "type": "stat",
      "gridPos": {"h": 4, "w": 5, "x": 10, "y": 1},
      "id": 3,
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "count(container_last_seen{name=~\"tasksync-.*\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        }
      },
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "center", "textMode": "value"},
      "links": [
        {
          "targetBlank": false,
          "title": "Open Docker Overview",
          "url": "/d/tasksync-docker-overview?var-datasource=${datasource}&var-environment=${environment}"
        }
      ]
    },
    {
      "title": "Prometheus Target Health",
      "type": "stat",
      "gridPos": {"h": 4, "w": 5, "x": 15, "y": 1},
      "id": 4,
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "sum(up{environment=~\"$environment\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "center", "textMode": "value"},
      "links": [
        {
          "targetBlank": false,
          "title": "Open Diagnostics Overview",
          "url": "/d/tasksync-development-diagnostics?var-datasource=${datasource}&var-environment=${environment}"
        }
      ]
    },
    {
      "title": "Active Observability Alerts",
      "type": "alertlist",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
      "id": 5,
      "options": {
        "show": "current",
        "stateFilter": ["firing"]
      }
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 101,
      "title": "2. Application Health",
      "type": "row"
    },
    {
      "title": "HTTP Requests/sec",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 6},
      "id": 10,
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{environment=~\"$environment\"}[$rate_interval]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 80}
            ]
          }
        }
      },
      "links": [
        {
          "targetBlank": false,
          "title": "Open API Overview",
          "url": "/d/tasksync-api-overview?var-datasource=${datasource}&var-environment=${environment}"
        }
      ]
    },
    {
      "title": "Request Success Rate",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 6},
      "id": 11,
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "(sum(rate(http_requests_total{status_code!~\"[45]..\", environment=~\"$environment\"}[$rate_interval])) / sum(rate(http_requests_total{environment=~\"$environment\"}[$rate_interval]))) * 100 or vector(100)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 95},
              {"color": "green", "value": 99.5}
            ]
          }
        }
      },
      "links": [
        {
          "targetBlank": false,
          "title": "Open Error Overview",
          "url": "/d/tasksync-error-overview?var-datasource=${datasource}&var-environment=${environment}"
        }
      ]
    },
    {
      "title": "Error Rate",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 6},
      "id": 12,
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "(sum(rate(http_requests_total{status_code=~\"[45]..\", environment=~\"$environment\"}[$rate_interval])) / sum(rate(http_requests_total{environment=~\"$environment\"}[$rate_interval]))) * 100 or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1.0},
              {"color": "red", "value": 5.0}
            ]
          }
        }
      },
      "links": [
        {
          "targetBlank": false,
          "title": "Open Error Overview",
          "url": "/d/tasksync-error-overview?var-datasource=${datasource}&var-environment=${environment}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 12},
      "id": 102,
      "title": "3. Infrastructure Health",
      "type": "row"
    },
    {
      "title": "System CPU Usage",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 13},
      "id": 20,
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "system_cpu_usage_ratio{environment=~\"$environment\"} * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 75},
              {"color": "red", "value": 90}
            ]
          }
        }
      },
      "links": [
        {
          "targetBlank": false,
          "title": "Open Infrastructure Overview",
          "url": "/d/tasksync-infrastructure-overview?var-datasource=${datasource}&var-environment=${environment}"
        }
      ]
    },
    {
      "title": "System Memory Usage",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 13},
      "id": 21,
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "system_memory_usage_bytes{environment=~\"$environment\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 4294967296},
              {"color": "red", "value": 8589934592}
            ]
          }
        }
      },
      "links": [
        {
          "targetBlank": false,
          "title": "Open Infrastructure Overview",
          "url": "/d/tasksync-infrastructure-overview?var-datasource=${datasource}&var-environment=${environment}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 19},
      "id": 103,
      "title": "4. Performance",
      "type": "row"
    },
    {
      "title": "Average Response Time",
      "type": "stat",
      "gridPos": {"h": 4, "w": 12, "x": 0, "y": 20},
      "id": 30,
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "sum(rate(http_request_duration_seconds_sum{environment=~\"$environment\"}[$rate_interval])) / sum(rate(http_request_duration_seconds_count{environment=~\"$environment\"}[$rate_interval]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "red", "value": 1.0}
            ]
          }
        }
      },
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "center", "textMode": "value"},
      "links": [
        {
          "targetBlank": false,
          "title": "Open API Overview",
          "url": "/d/tasksync-api-overview?var-datasource=${datasource}&var-environment=${environment}"
        }
      ]
    },
    {
      "title": "P95 Response Time",
      "type": "stat",
      "gridPos": {"h": 4, "w": 12, "x": 12, "y": 20},
      "id": 31,
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{environment=~\"$environment\"}[$rate_interval])) by (le))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.8},
              {"color": "red", "value": 1.5}
            ]
          }
        }
      },
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "center", "textMode": "value"},
      "links": [
        {
          "targetBlank": false,
          "title": "Open API Overview",
          "url": "/d/tasksync-api-overview?var-datasource=${datasource}&var-environment=${environment}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 24},
      "id": 104,
      "title": "5. Database & Cache",
      "type": "row"
    },
    {
      "title": "Database Status",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 25},
      "id": 40,
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "(sum(rate(db_queries_successful_total{environment=~\"$environment\"}[$rate_interval])) / (sum(rate(db_queries_successful_total{environment=~\"$environment\"}[$rate_interval])) + sum(rate(db_queries_failed_total{environment=~\"$environment\"}[$rate_interval])) or sum(rate(db_queries_successful_total{environment=~\"$environment\"}[$rate_interval])))) * 100 or vector(100)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 98},
              {"color": "green", "value": 100}
            ]
          }
        }
      },
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "center", "textMode": "value"},
      "links": [
        {
          "targetBlank": false,
          "title": "Open Database Overview",
          "url": "/d/tasksync-database-overview?var-datasource=${datasource}&var-environment=${environment}"
        }
      ]
    },
    {
      "title": "Redis Status",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 25},
      "id": 41,
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "((sum(rate(redis_requests_total{environment=~\"$environment\"}[$rate_interval])) - (sum(rate(redis_failures_total{environment=~\"$environment\"}[$rate_interval])) or vector(0))) / sum(rate(redis_requests_total{environment=~\"$environment\"}[$rate_interval]))) * 100 or vector(100)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 98},
              {"color": "green", "value": 100}
            ]
          }
        }
      },
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "center", "textMode": "value"},
      "links": [
        {
          "targetBlank": false,
          "title": "Open Redis Overview",
          "url": "/d/tasksync-redis-overview?var-datasource=${datasource}&var-environment=${environment}"
        }
      ]
    },
    {
      "title": "Cache Hit Ratio",
      "type": "gauge",
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 25},
      "id": 42,
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "editorMode": "code",
          "expr": "((sum(rate(redis_requests_total{environment=~\"$environment\"}[$rate_interval])) - (sum(rate(redis_failures_total{environment=~\"$environment\"}[$rate_interval])) or vector(0))) / sum(rate(redis_requests_total{environment=~\"$environment\"}[$rate_interval]))) * 100 or vector(100)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 90},
              {"color": "green", "value": 95}
            ]
          }
        }
      },
      "links": [
        {
          "targetBlank": false,
          "title": "Open Redis Overview",
          "url": "/d/tasksync-redis-overview?var-datasource=${datasource}&var-environment=${environment}"
        }
      ]
