        "x": 20,
        "y": 1
      },
      "id": 6,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(timeout_errors_total{environment=~\"$environment\"}[$interval])) or vector(0)",
