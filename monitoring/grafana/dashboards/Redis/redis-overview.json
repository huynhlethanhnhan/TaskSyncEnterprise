    {
      "title": "Cache Failures Rate",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 2,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(redis_failures_total{job=~\"$job\", instance=~\"$instance\", environment=~\"$environment\"}[$rate_interval])) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
