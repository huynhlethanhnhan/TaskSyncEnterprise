          "editorMode": "code",
          "expr": "sum(rate(redis_query_duration_seconds_sum{job=~\"$job\", instance=~\"$instance\", environment=~\"$environment\", command=~\"$redis_command\"}[$rate_interval])) / sum(rate(redis_query_duration_seconds_count{job=~\"$job\", instance=~\"$instance\", environment=~\"$environment\", command=~\"$redis_command\"}[$rate_interval]))",
