# TaskSyncEnterprise Backup Infrastructure Configuration Template
# IMPORTANT: DO NOT commit production secrets to Git!
# Inject sensitive credentials (e.g. MSSQL_SA_PASSWORD) at runtime via environment variables (SQLCMDPASSWORD),
# secrets manager, or Docker secrets.

# Root directory for backup storage bundles (Relative to repository or absolute path)
BACKUP_ROOT=./backups

# Target deployment environment
BACKUP_ENVIRONMENT=production

# Docker Container Names (production orchestration defaults)
BACKUP_DATABASE_CONTAINER=tasksync-sqlserver-prod
BACKUP_DATABASE_NAME=TaskSyncEnterprise
BACKUP_DATABASE_CONTAINER_PATH=/var/opt/mssql/backup

BACKUP_BACKEND_CONTAINER=tasksync-backend-prod
BACKUP_UPLOADS_PATH=/app/uploads
BACKUP_INCLUDE_UPLOADS=true

BACKUP_REDIS_CONTAINER=tasksync-redis-prod
BACKUP_INCLUDE_REDIS=false
BACKUP_REDIS_FAILURE_POLICY=fail

# Retention Policy (Number of backups to keep)
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12

# Backup Encryption Provider (Options: none, aes-256-gcm, age, cloud_sse)
# Default is 'none' for local bundles. Use authenticated encryption for offsite transport.
BACKUP_ENCRYPTION_PROVIDER=none

# Offsite Remote Transport Provider (Options: none, s3, azure_blob)
BACKUP_REMOTE_PROVIDER=none
