# ==================================================
# TaskSyncEnterprise Environment Configuration Example
# Copy this template to '.env' and adjust parameters.
# NEVER commit populated '.env' files with real secrets.
# ==================================================

# Application Profile & Identity
ENVIRONMENT=development
APP_NAME=TaskSyncEnterprise
API_V1_STR=/api/v1

# Security Key (Must be at least 32 random characters in production)
SECRET_KEY=replace-with-a-strong-random-secret-at-least-32-characters

# MS SQL Server Database Contract
MSSQL_HOST=sqlserver
MSSQL_PORT=1433
MSSQL_DATABASE=TaskSyncEnterprise
MSSQL_USER=sa
MSSQL_PASSWORD=replace-with-a-strong-password
MSSQL_SA_PASSWORD=replace-with-a-strong-password

# Redis Cache Contract
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# CORS & Network Boundaries
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_URL=/api/v1

# Database Seed & Reset Rules (Default: Safe Production Settings)
RUN_DEMO_SEED=false
ALLOW_DESTRUCTIVE_RESET=false

# Monitoring Configuration
PROMETHEUS_BIND_ADDRESS=127.0.0.1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-admin-password
