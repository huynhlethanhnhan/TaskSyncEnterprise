# Application profile. Production enables stricter startup validation.
ENVIRONMENT=development

# Replace with a unique random secret. Never commit a populated .env file.
SECRET_KEY=replace-with-a-strong-random-secret-at-least-32-characters

# SQL Server Authentication used by the Docker SQL Server container.
MSSQL_SA_PASSWORD=replace-with-a-strong-local-password

# Keep the password in DATABASE_URL synchronized with MSSQL_SA_PASSWORD.
DATABASE_URL=mssql+pymssql://sa:replace-with-a-strong-local-password@sqlserver:1433/TaskSyncEnterprise

# Docker Compose service hostname for the Redis container.
REDIS_URL=redis://redis:6379/0

# Prometheus has no authentication in this local stack; keep it on loopback.
PROMETHEUS_BIND_ADDRESS=127.0.0.1
